%% NVFlow - Execution Flow Diagram
%% Shows how a workflow is executed from user command to completion

sequenceDiagram
    actor User
    participant CLI as CLI (nflow)
    participant WR as WorkflowRunner
    participant SR as StageRegistry
    participant Stage as Stage Instance
    participant NS as NeMo-Skills
    participant Slurm as Slurm Cluster
    participant Node as Compute Node

    %% Initialization Phase
    rect rgb(225, 245, 255)
        Note over User,CLI: 🚀 Initialization Phase
        User->>CLI: nflow run-all<br/>--config workflow.yaml
        CLI->>WR: __init__(config_path)
        WR->>WR: Load YAML config
        WR->>WR: Resolve _base_ inheritance
        WR->>WR: Expand models and checkpoints
        WR->>WR: Extract recipe/workflow context
        WR-->>CLI: Runner ready
    end

    %% Validation Phase
    rect rgb(232, 245, 233)
        Note over CLI,WR: ✅ Validation Phase
        CLI->>WR: validate_config()
        WR->>SR: has(recipe, workflow, stage)?
        SR-->>WR: True for all stages
        WR-->>CLI: Config valid
    end

    %% Execution Phase
    rect rgb(255, 244, 230)
        Note over CLI,Node: ⚙️ Execution Phase (Loop for each stage)

        CLI->>WR: run(stages=None)

        loop For each stage in pipeline_stages
            WR->>SR: get(recipe, workflow, stage)
            SR-->>WR: StageClass
            WR->>Stage: __init__()
            WR->>Stage: validate_config(config)
            Stage-->>WR: Valid

            alt Has dependencies
                Note over WR: Build run_after list<br/>from dependency expnames
            end

            WR->>Stage: execute(config, cluster,<br/>expname, run_after)

            %% Stage delegates to NeMo-Skills
            Stage->>NS: pipeline.run(...)
            NS->>NS: Build sbatch script
            NS->>NS: Package code snapshot
            NS->>Slurm: sbatch job.sh<br/>--dependency=afterok:123
            Slurm-->>NS: Job ID: 456
            NS-->>Stage: Job submitted: 456
            Stage-->>WR: Stage complete

            %% Background: Slurm execution
            par Slurm Execution (Background)
                Slurm->>Slurm: Wait for dependencies
                Slurm->>Node: Allocate resources<br/>(GPUs, CPUs, memory)
                Node->>Node: Load container image
                Node->>Node: Mount shared filesystem
                Node->>Node: Execute stage script
                Node->>Node: Write outputs to storage
                Node-->>Slurm: Job complete (exit code)
            end
        end

        WR-->>CLI: All stages submitted
        CLI-->>User: ✅ Workflow complete!<br/>Check job outputs in<br/>jobs/experiments/
    end

    %% Monitoring Phase
    rect rgb(243, 229, 245)
        Note over User,Node: 📊 Monitoring Phase (User-initiated)
        User->>Slurm: squeue -u $USER
        Slurm-->>User: Job status
        User->>Node: tail -f job.log
        Node-->>User: Live output
    end
